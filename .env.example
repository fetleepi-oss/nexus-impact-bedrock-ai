# ===========================================================================
# Nexus Impact AI - Environment Configuration Example
# Copy this file to .env before starting the server.
# NEVER commit real API keys or AWS credentials to version control.
# No secrets should ever be prefixed with VITE_ or NEXT_PUBLIC_.
# ===========================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production

# Feature Entitlement & Simulation Flags
# UNLOCK_ALL_AGENTS: When true, unlocks all 7 specialized agents without paywalls
UNLOCK_ALL_AGENTS=true
# ALLOW_SIMULATED_RESPONSES: When false (default), missing/failed Bedrock returns a clear error.
# If true, simulated template responses are explicitly badged with "[SIMULATED, not from Amazon Bedrock]"
ALLOW_SIMULATED_RESPONSES=false

# Amazon Bedrock Credentials (Server-Side Only - Never Exposed to Browser)
# AWS IAM user/role must have 'bedrock:InvokeModel' permission
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# Note: Claude 3.5 on Bedrock requires a regional inference profile (prefixed with "us.")
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# Server-Side Cost & Abuse Protection
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=60
DAILY_REQUEST_CAP=200
MAX_INPUT_LENGTH=10000
MAX_TOKENS_CAP=2048
REQUEST_TIMEOUT_MS=25000

# Model Context Protocol (MCP) Configuration (Spec 2025-11-25)
MCP_PROTOCOL_VERSION=2025-11-25
MCP_SERVER_NAME=nexus-impact-ai-mcp
