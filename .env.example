# ===========================================================================
# Nexus Impact AI - Environment Configuration Example
# Copy this file to .env before starting the server.
# NEVER commit real API keys or AWS credentials to version control.
# ===========================================================================

# Server Network Configuration
PORT=3000
APP_URL="http://localhost:3000"

# Hackathon Demo Mode
# When "true", all 7 Pro agents and unlimited generations are unlocked for judges
DEMO_MODE="true"

# AWS Bedrock Foundation Model Credentials (Server-Side Only - Never Exposed to Browser)
# If omitted or running locally, Nexus Impact AI automatically uses high-fidelity domain simulations
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_access_key_id_here"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key_here"
BEDROCK_MODEL_ID="anthropic.claude-3-5-sonnet-20241022-v2:0"

# Google Gemini API Key (Optional Server-Side Proxy)
GEMINI_API_KEY="your_gemini_api_key_here"

# Model Context Protocol (MCP) Configuration
MCP_PROTOCOL_VERSION="2025-11-25"
MCP_SERVER_NAME="nexus-impact-ai-mcp"
